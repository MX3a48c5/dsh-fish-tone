{
  "name": "dsh-fish-tone-flavor",
  "version": "0.1.1",
  "description": "人味插件的附属包：可爱 / 抽象 / 热梗库（默认关，开了才挂性格层）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "client.js",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "license": "MIT"
}
